{
  "name": "@entanglement/core",
  "version": "0.1.0",
  "description": "Local-first sync framework: git-style VCS mode and realtime mode over one commit protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqljs": {
      "types": "./dist/sqljs.d.ts",
      "default": "./dist/sqljs.js"
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "sql.js": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "sql.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "sql.js": "^1.12.0",
    "@types/sql.js": "^1.4.9"
  }
}
